{
  "name": "nexo-assist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n tickets,app -c magenta,cyan \"npm:dev:tickets\" \"npm:dev:app\"",
    "dev:app": "next dev",
    "dev:tickets": "tsx watch --env-file-if-exists=.env services/tickets/src/server.ts",
    "build": "next build",
    "start": "concurrently -k -n tickets,app -c magenta,cyan \"npm:start:tickets\" \"npm:start:app\"",
    "start:app": "next start",
    "start:tickets": "tsx --env-file-if-exists=.env services/tickets/src/server.ts",
    "setup": "node -e \"require('fs').existsSync('.env')||require('fs').copyFileSync('.env.example','.env')\"",
    "reset-data": "node -e \"for (const f of require('fs').readdirSync('data')) if (f !== '.gitkeep') require('fs').rmSync('data/'+f, { recursive: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.89",
    "@electric-sql/pglite": "^0.5.12",
    "@hono/node-server": "^2.1.5",
    "@mastra/core": "^1.79.0",
    "@neondatabase/serverless": "^1.2.0",
    "hono": "^4.13.14",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.34",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ai": "^7.0.154",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
