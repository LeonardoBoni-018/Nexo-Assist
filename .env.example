# --- Modelo (Anthropic) ---
# Chave da API da Anthropic. Sem ela o app abre, mas o agent responde com erro.
ANTHROPIC_API_KEY=
# Modelo do agent (padrão: claude-opus-5-5). Alternativas: claude-sonnet-5-5, claude-haiku-5-5
NEXO_MODEL=claude-opus-5-5
# Esforço de raciocínio: low | medium | high (padrão: low — atendimento não pede raciocínio longo)
NEXO_EFFORT=low

# --- App ---
# Segredo para assinar o cookie de sessão. Gere com: openssl rand -base64 32
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio
APP_DB_PATH=data/app.db
# Limites de uso (custo e abuso)
NEXO_MESSAGE_LIMIT=30
NEXO_DAILY_TURN_LIMIT=120
# Abaixo desta confiança (0–1) o servidor transfere a conversa para um analista
NEXO_MIN_CONFIDENCE=0.4

# --- Serviço de chamados (processo separado) ---
TICKETS_URL=http://127.0.0.1:4001
TICKETS_PORT=4001
# Segredo compartilhado entre o app e o serviço de chamados
TICKETS_SERVICE_KEY=troque-esta-chave
TICKETS_DB_PATH=data/tickets.db
# Simulação do sistema legado: probabilidade de 503 e latência máxima (ms)
TICKETS_FAILURE_RATE=0.1
TICKETS_MAX_LATENCY_MS=300
